{
  "name": "show-git-branch",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin showing the session workspace's current git branch beside the composer mode selector",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "host",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-cordis-client-runner"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "bundle": "tsdown"
  },
  "devDependencies": {
    "tsdown": "^0.12.0"
  }
}
